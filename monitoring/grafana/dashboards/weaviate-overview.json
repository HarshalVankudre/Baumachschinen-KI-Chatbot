{
  "dashboard": {
    "title": "Weaviate Overview - Baumaschinen-KI",
    "tags": ["weaviate", "vector-database", "baumaschinen-ki"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Query Rate (queries/sec)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(weaviate_requests_total[5m])",
            "legendFormat": "{{class_name}} - {{operation}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Queries/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Query Latency (p95)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(weaviate_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{class_name}} - p95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Object Count by Collection",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "weaviate_object_count",
            "legendFormat": "{{class_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Objects"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"weaviate\"}",
            "legendFormat": "RSS Memory",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Memory"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Batch Import Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(weaviate_batch_durations_ms_count[5m])",
            "legendFormat": "Batches/sec",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Batches/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(weaviate_requests_total{status=~\"4..|5..\"}[5m])",
            "legendFormat": "{{status}} - {{class_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Errors/sec"},
          {"format": "short"}
        ]
      }
    ]
  },
  "overwrite": true
}
